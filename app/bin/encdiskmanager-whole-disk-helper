#!/bin/sh
# Read-only whole-USB-disk helper. Encryption is deliberately disabled.
set -eu

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

case "${1:-}" in
    check)
        [ "$#" -eq 6 ] || fail 'Usage: encdiskmanager-whole-disk-helper check /dev/sdX MAJOR:MINOR SYSFS_PATH SECTORS PARTITIONS'
        case "$2" in
            /dev/sd*) disk_letters=${2#/dev/sd} ;;
            *) fail 'Expected a whole /dev/sdX USB disk name.' ;;
        esac
        case "$disk_letters" in
            ''|*[!a-z]*) fail 'Expected a whole /dev/sdX USB disk name.' ;;
        esac

        [ -b "$2" ] || fail 'Selected path is not a block device.'
        sysfs="/sys/class/block/sd$disk_letters"
        [ -e "$sysfs" ] || fail 'Kernel block device is unavailable.'
        [ ! -e "$sysfs/partition" ] || fail 'Selected device is a partition.'
        resolved="$(/usr/bin/readlink -f "$sysfs")" ||
            fail 'Cannot resolve kernel device path.'
        case "$resolved" in
            */usb[0-9]*/*) ;;
            *) fail 'Selected device is not USB-backed.' ;;
        esac
        [ -r "$sysfs/dev" ] && [ -r "$sysfs/size" ] && [ -r "$sysfs/ro" ] ||
            fail 'Kernel device details are unavailable.'
        IFS= read -r device_id < "$sysfs/dev" ||
            fail 'Cannot read kernel device identity.'
        IFS= read -r sectors < "$sysfs/size" ||
            fail 'Cannot read disk size.'
        IFS= read -r read_only < "$sysfs/ro" ||
            fail 'Cannot read disk read-only state.'
        case "$device_id" in
            *:*)
                major=${device_id%%:*}
                minor=${device_id#*:}
                case "$major:$minor" in
                    :*|*:|*[!0-9:]*|*:*:*) fail 'Invalid kernel device identity.' ;;
                esac
                ;;
            *) fail 'Invalid kernel device identity.' ;;
        esac
        case "$sectors" in
            ''|*[!0-9]*) fail 'Invalid disk size.' ;;
        esac
        [ "$sectors" != 0 ] || fail 'Disk has zero capacity.'
        [ "$read_only" = 0 ] || fail 'Disk is read-only or its state is unknown.'
        identity_check="$(dirname "$0")/whole-disk-identity-check.sh"
        [ -r "$identity_check" ] || fail 'Identity comparison is unavailable.'
        sh "$identity_check" "sd$disk_letters" "$3" "$4" "$5" \
            "$device_id" "$resolved" "$sectors" ||
            fail 'Live disk identity differs from the confirmed identity.'
        # Check kernel mount IDs (also catches mounts through UUID aliases).
        [ -r /proc/self/mountinfo ] || fail 'Mount information is unavailable.'
        device_ids="$device_id"
        live_partitions=""
        for partition in "$sysfs"/sd"$disk_letters"[0-9]*; do
            [ -e "$partition/partition" ] || continue
            [ -r "$partition/dev" ] || fail 'Partition identity is unavailable.'
            IFS= read -r partition_id < "$partition/dev" ||
                fail 'Cannot read partition identity.'
            partition_name=${partition##*/}
            case "$partition_id" in
                *:*) part_major=${partition_id%%:*}; part_minor=${partition_id#*:} ;;
                *) fail 'Invalid partition identity.' ;;
            esac
            case "$part_major:$part_minor" in
                :*|*:|*[!0-9:]*|*:*:*) fail 'Invalid partition identity.' ;;
            esac
            live_partitions="${live_partitions}${live_partitions:+,}${partition_name}=${partition_id}"
            device_ids="$device_ids $partition_id"
        done
        [ "$6" = "$live_partitions" ] ||
            fail 'Live partition identities differ from the confirmed partition list.'
        busy_check="$(dirname "$0")/whole-disk-busy-check.awk"
        [ -r "$busy_check" ] || fail 'Busy-device check is unavailable.'
        if ! awk -v mode=mount -v ids="$device_ids" -f "$busy_check" /proc/self/mountinfo; then
            fail 'Disk or partition is mounted, or mount information is invalid.'
        fi

        # Swap does not appear in mountinfo.
        [ -r /proc/swaps ] || fail 'Swap information is unavailable.'
        if ! awk -v mode=swap -v disk="$2" -f "$busy_check" /proc/swaps; then
            fail 'Disk or partition is in use as swap.'
        fi
        dependencies="$(dirname "$0")/whole-disk-dependencies.sh"
        [ -r "$dependencies" ] || fail 'Dependency check is unavailable.'
        sh "$dependencies" "$sysfs" ||
            fail 'Disk has block-device dependencies or dependency status is unavailable.'
        fail 'Read-only USB check completed. Encryption is disabled; no disk was modified.'
        ;;
    *)
        fail 'Usage: encdiskmanager-whole-disk-helper check /dev/sdX MAJOR:MINOR SYSFS_PATH SECTORS PARTITIONS (disabled)'
        ;;
esac
